# Meta Ad Library API (official). Get one at https://developers.facebook.com/
# Without this, MetaGraphAPISource raises a controlled error (source=meta_graph_api, status=missing_token).
META_ACCESS_TOKEN=

# Optional: override default database path (SQLite by default, Postgres DSN also accepted)
ECI_DATABASE_URL=sqlite:///data/eci.db

# Optional: HTTP client tuning
ECI_HTTP_TIMEOUT_SECONDS=15
ECI_HTTP_MAX_RETRIES=3

# SECURITY: keep this true. Only set to false if you're behind a TLS-intercepting proxy
# (some sandboxed/corporate dev environments) whose certificate isn't in your trust store,
# which makes every real store fetch fail with CERTIFICATE_VERIFY_FAILED. Never disable
# this on a normal machine/production run — it removes MITM protection.
ECI_HTTP_VERIFY_SSL=true
